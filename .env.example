# Copy to .env and fill in as needed. Never commit the real .env file.

# Optional: override default DuckDB file location
SHIPPING_DB_PATH=data/duckdb/shipping.duckdb

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Placeholders for future licensed sources (Step 2+). Leave blank until purchased.
CLARKSONS_API_KEY=
VESSELSVALUE_API_KEY=
XENETA_API_KEY=
SP_GLOBAL_API_KEY=

# Free, no-cost registered keys for the macro/context adapters (added August 2026). Register at
# https://fred.stlouisfed.org/docs/api/api_key.html and https://www.eia.gov/opendata/ respectively.
# Blank is safe -- the adapters skip themselves and log a warning rather than failing the whole run.
FRED_API_KEY=
EIA_API_KEY=
